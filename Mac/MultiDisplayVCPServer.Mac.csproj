<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Version>2.0.0</Version>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>MultiDisplayVCPServer.Mac</RootNamespace>
    <AssemblyName>MultiDisplayVCPServer.Mac</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MagicOnion.Server" Version="7.11.0" />
    <PackageReference Include="MemoryPack" Version="1.21.4" />
    <PackageReference Include="ZString" Version="2.6.0" />
    <PackageReference Include="MessagePipe" Version="1.8.2" />
    <PackageReference Include="ZLinq" Version="1.5.6" />
    <PackageReference Include="ObservableCollections" Version="3.3.4" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Shared\*.cs" Link="Shared\%(Filename)%(Extension)" />
    <Compile Include="..\Services\*.cs" Link="Services\%(Filename)%(Extension)" />
    <Compile Include="..\Messaging\*.cs" Link="Messaging\%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
